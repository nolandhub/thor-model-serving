# ABOUTME: Nguồn sự thật duy nhất cho cổng và tên - copy thành .env rồi sửa
# ABOUTME: compose đọc .env tự động; scripts/serving.sh source nó; tests đọc nó

COMPOSE_PROJECT_NAME=thor-voice

# Địa chỉ host để publish. 127.0.0.1 = chỉ gọi được từ chính Thor hoặc qua SSH
# tunnel. Đổi thành IP LAN của Thor khi cần cho máy khác gọi vào inference -
# lúc đó nhớ Triton KHÔNG có authentication, xem README mục "Gọi từ máy khác".
BIND_ADDR=127.0.0.1

# Data plane - client gọi inference
ASR_HTTP_PORT=4000
ASR_GRPC_PORT=4001

# Control plane - vận hành, luôn nên để sau tunnel vì Grafana bật anonymous admin
PROM_PORT=4002
GRAFANA_PORT=4003

# Tag image build tại chỗ. Không có registry nội bộ nên đây là đường rollback
# duy nhất - đặt theo git sha khi deploy thật: IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=dev

# Base image do team khác kiểm soát. Ghim theo digest khi cần bản dựng lặp lại
# được: ASR_BASE_IMAGE=asr-triton@sha256:...
ASR_BASE_IMAGE=asr-triton:latest
