# ABOUTME: Template scrape config cho Thor - deploy_monitoring.sh render ra prometheus.yml, thay __ASR_METRICS_PORT__
# ABOUTME: Prometheus/Grafana chạy network_mode host nên localhost ở đây là host thật

global:
  scrape_interval: 5s
  evaluation_interval: 15s

scrape_configs:
  - job_name: triton
    static_configs:
      - targets: ["localhost:__ASR_METRICS_PORT__"]
