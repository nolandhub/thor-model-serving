# SINH TỰ ĐỘNG bởi scripts/gen_encoder_config.py - đừng sửa tay.
# 74 khối state ghép theo VỊ TRÍ giữa input[1:] và output[1:].
# max_batch_size: 0 vì trục batch không đồng nhất - xem docstring của script.

name: "encoder"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [1, 45, 80]
  }
]

output [
  {
    name: "encoder_out"
    data_type: TYPE_FP32
    dims: [-1, -1, 512]
  }
]

sequence_batching {
  max_sequence_idle_microseconds: 60000000
  oldest {
    max_candidate_sequences: 64
    max_queue_delay_microseconds: 0
  }
  state [
    {
      input_name: "cached_key_0"
      output_name: "new_cached_key_0"
      data_type: TYPE_FP32
      dims: [128, 1, 128]
